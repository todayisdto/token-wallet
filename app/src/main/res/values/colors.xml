<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeepSeek-inspired blue palette -->
    <color name="brand">#FF23272E</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="brand_container">#FFEFF1F4</color>
    <color name="on_brand_container">#FF23272E</color>
    <color name="accent">#FF7C8CFF</color>
